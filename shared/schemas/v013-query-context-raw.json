{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipecat.example/schemas/v013-query-context-raw.json",
  "title": "v0.1.3 Phase 4A query-context raw record",
  "description": "One credential-safe raw sample from the query-context narrowing experiment (docs/benchmarks/v0.1.3-query-context-raw.jsonl). Strict allowlist: no transcript or prompt content, no free-form fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "run_block",
    "run_order",
    "fixture_version",
    "fixture_turn_id",
    "condition",
    "selected_dimension",
    "selected_value",
    "context_chars",
    "query_chars",
    "provider",
    "model",
    "latency_ms",
    "outcome",
    "quality_score",
    "matched_fact_ids",
    "matched_citation_ids",
    "matched_disallowed_claim_ids",
    "scorer_version",
    "scorer_hash",
    "attempt_count",
    "retry_count",
    "rate_limit_count",
    "cache_status",
    "retrieval_snapshot_id",
    "recorded_at_utc"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "run_block": {"type": "integer", "minimum": 0},
    "run_order": {"type": "integer", "minimum": 0},
    "fixture_version": {"type": "string", "minLength": 1},
    "fixture_turn_id": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "enum": ["baseline", "narrowed"]},
    "selected_dimension": {
      "type": "string",
      "enum": ["history_count", "answer_chars"]
    },
    "selected_value": {"type": "integer", "minimum": 0},
    "context_chars": {"type": "integer", "minimum": 0},
    "query_chars": {"type": "integer", "minimum": 0},
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "model": {"type": "string", "minLength": 1, "maxLength": 64},
    "latency_ms": {"type": "number", "minimum": 0},
    "outcome": {"type": "string", "enum": ["success", "error", "timeout"]},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
    "matched_fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "matched_citation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "matched_disallowed_claim_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scorer_version": {"type": "string", "minLength": 1},
    "scorer_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "attempt_count": {"type": "integer", "minimum": 1},
    "retry_count": {"type": "integer", "minimum": 0},
    "rate_limit_count": {"type": "integer", "minimum": 0},
    "cache_status": {"type": "string", "enum": ["hit", "miss", "unknown"]},
    "retrieval_snapshot_id": {"type": ["string", "null"], "minLength": 1},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
  }
}
