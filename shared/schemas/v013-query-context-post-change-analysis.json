{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipecat-subagents-lab.local/schemas/v1/v013-query-context-post-change-analysis.json",
  "title": "v0.1.3 Phase 4C promoted post-change analysis artifact",
  "description": "Strict artifact produced only when Phase 4B promotes query-context narrowing and Phase 4C lands the runtime change. Bound into the final promotion manifest by SHA-256 as phase4c_artifact_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "promotion_eligible",
    "post_change_source_commit",
    "post_change_source_tree_hash",
    "phase3_completion_hash",
    "phase4b_baseline_input_sha256",
    "phase4b_normalized_input_sha256",
    "experiment_command_digest",
    "analyzer_command_digest",
    "fixture_version",
    "fixture_sha256",
    "scorer_version",
    "scorer_hash",
    "control_fingerprint",
    "generated_at_utc"
  ],
  "properties": {
    "status": {"type": "string", "const": "promoted"},
    "promotion_eligible": {"type": "boolean", "const": true},
    "post_change_source_commit": {"type": "string", "minLength": 1},
    "post_change_source_tree_hash": {"type": "string", "minLength": 1},
    "phase3_completion_hash": {"type": "string", "minLength": 1},
    "phase4b_baseline_input_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "phase4b_normalized_input_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "experiment_command_digest": {"type": "string", "minLength": 1},
    "analyzer_command_digest": {"type": "string", "minLength": 1},
    "fixture_version": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "scorer_version": {"type": "string", "minLength": 1},
    "scorer_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "control_fingerprint": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "minLength": 1}
  }
}
