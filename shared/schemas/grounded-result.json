{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipecat-subagents-lab.local/schemas/v1/grounded-result.json",
  "title": "GroundedResult", "type": "object", "additionalProperties": false,
  "required": ["result_id", "worker_id", "turn_id", "text", "citations", "spoken_text", "ui_text", "spoken_result_id", "ui_result_id", "spoken_citations", "ui_citations", "origin_epoch"],
  "properties": {
    "result_id": {"type": "string"}, "worker_id": {"type": "string"}, "turn_id": {"type": "string"}, "text": {"type": "string"},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}, "spoken_text": {"type": "string"}, "ui_text": {"type": "string"},
    "spoken_result_id": {"type": ["string", "null"]}, "ui_result_id": {"type": ["string", "null"]},
    "spoken_citations": {"type": ["array", "null"], "items": {"$ref": "#/$defs/citation"}}, "ui_citations": {"type": ["array", "null"], "items": {"$ref": "#/$defs/citation"}}, "origin_epoch": {"type": ["integer", "null"]}
  },
  "$defs": {"citation": {"type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://[^\\s]+$"}}}}
}
