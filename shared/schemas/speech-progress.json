  "properties": {"result_id": {"type": "string"}, "work_item_id": {"type": "string"}, "run_id": {"type": "string"}, "utterance_id": {"type": "string"}, "state": {"enum": ["displayed", "queued", "started", "synthesis_ended", "delivery_completed", "delivery_unknown", "interrupted", "interrupted_by_reconnect", "paused", "resumed"]}, "origin_epoch": {"type": ["integer", "null"]}}
}
